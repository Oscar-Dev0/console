    "kleur": "^4.1.5"
  },
  "packageManager": "pnpm@10.22.0",
  "bugs": {
    "url": "https://github.com/Oscar-Dev0/console/issues"
  },
  "homepage": "https://github.com/Oscar-Dev0/console#readme",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.1",
